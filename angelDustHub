local function CreateSlider(p, t, min, max, def, cb)
    local f = Instance.new("Frame"); f.Size = UDim2.new(1,-12,0,65); f.BackgroundTransparency = 1; f.Parent = p
    local l = Instance.new("TextLabel"); l.Size = UDim2.new(1,0,0,25); l.BackgroundTransparency = 1; l.TextColor3 = Theme.Text; l.Font = Enum.Font.GothamMedium; l.TextXAlignment = Enum.TextXAlignment.Left; l.Parent = f; l:SetAttribute("IsDynamic", true)
    local tr = Instance.new("TextButton"); tr.Name = "SliderTrack"; tr.Size = UDim2.new(1,0,0,13); tr.Position = UDim2.fromOffset(0,37); tr.BackgroundColor3 = Theme.Panel; tr.Text = ""; tr.AutoButtonColor = false; tr.Parent = f; Corner(tr,8); Stroke(tr, Theme.Accent, 2)
    local fill = Instance.new("Frame"); fill.Name = "SliderFill"; fill.Size = UDim2.new(0,0,1,0); fill.BackgroundColor3 = Theme.Accent; fill.BorderSizePixel = 0; fill.Parent = tr; Corner(fill,8)
    local val = def
    local function SetVal(nv) 
        nv = math.clamp(nv, min, max)
        val = math.floor(nv) 
        fill.Size = UDim2.new((val-min)/(max-min), 0, 1, 0)
        l.Text = t..": "..tostring(val)
        if cb then cb(val) end 
    end
    local function UpdateX(x) 
        local w = tr.AbsoluteSize.X
        -- ФИКС 10: Защита от деления на ноль
        if w > 0 and max > min then 
            SetVal(min + (max-min)*math.clamp((x - tr.AbsolutePosition.X)/w, 0, 1)) 
        end 
    end
    SafeConnect(tr.InputBegan, function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then ActiveSlider = UpdateX UpdateX(i.Position.X) end end)
    SetVal(def); return { Set = SetVal }
end

