local BlacklistedCoins = {}
local MapNames = { "Hospital3", "Office3", "House2", "Hotel", "Mansion", "Factory", "Bank", "School", "Lab", "ResearchFacility", "BioLab", "BeachResort", "Pier", "Workplace", "Mansion2", "Yacht", "MilBase", "PoliceStation" }
local LastAntiAFK = tick()

-- ФУНКЦИЯ ПОИСКА МОНЕТ
local function GetNearestCoin()
    local map = nil
    for _, n in pairs(MapNames) do local m = workspace:FindFirstChild(n) if m then map = m break end end
    if not map then return nil end
    local c = map:FindFirstChild("CoinContainer") 
    if not c or not Player.Character or not Player.Character:FindFirstChild("HumanoidRootPart") then return nil end
    local near, dist = nil, math.huge
    for _, coin in pairs(c:GetChildren()) do 
        if coin.Name == "Coin_Server" and coin:IsA("Part") then 
            local isBlacklisted = BlacklistedCoins[coin] and tick() < BlacklistedCoins[coin]
            if not isBlacklisted then
                local d = (Player.Character.HumanoidRootPart.Position - coin.Position).Magnitude 
                if d < dist then dist = d near = coin end 
            end
        end 
    end
    return near
end

