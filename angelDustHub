-- 2. ЦИКЛ ФИЗИКИ (Фарм, Полет, Защита)
SafeConnect(RunService.Heartbeat, function()
    if not IsAlive then return end
    local char = Player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end

    -- ФАРМ
    if AutoFarmEnabled and Player:GetAttribute("Alive") == true and not FlyEnabled then
        wasFarming = true
        hum:ChangeState(Enum.HumanoidStateType.Physics)
        
        -- Сохраняем коллизии ТОЛЬКО в FarmCollisions
        for _, part in ipairs(char:GetDescendants()) do 
            if part:IsA("BasePart") then 
                if FarmCollisions[part] == nil then FarmCollisions[part] = part.CanCollide end
                part.CanCollide = false 
            end 
        end

        if not farmBV then
            farmBV = Instance.new("BodyVelocity")
            farmBV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            farmBV.Parent = root
        end

        local coin = GetNearestCoin()
        if coin then
            local targetPos = coin.Position + Vector3.new(0, 2, 0)
            local dist = (root.Position - targetPos).Magnitude

            if dist > 4 then
                farmBV.Velocity = (targetPos - root.Position).Unit * (FarmSpeed * 1.5)
            else
                farmBV.Velocity = Vector3.zero
                root.CFrame = coin.CFrame + Vector3.new(0, 1, 0)
                BlacklistedCoins[coin] = tick() + 2
            end
        else
            farmBV.Velocity = Vector3.zero
        end
    else
        if farmBV then farmBV:Destroy() farmBV = nil end
        if wasFarming and char then
            -- Восстанавливаем коллизии ТОЛЬКО из FarmCollisions
            for _, part in ipairs(char:GetDescendants()) do 
                if part:IsA("BasePart") and FarmCollisions[part] ~= nil then 
                    part.CanCollide = FarmCollisions[part] 
                    FarmCollisions[part] = nil 
                end 
            end
            wasFarming = false
        end
        if not FlyEnabled then hum.PlatformStand = false end
    end

    -- ПОЛЕТ
    if FlyEnabled then
        hum:ChangeState(Enum.HumanoidStateType.Physics)
        if not flyBV then
            flyBV = Instance.new("BodyVelocity", root); flyBV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            flyBG = Instance.new("BodyGyro", root); flyBG.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        end

        local cam = workspace.CurrentCamera
        local moveDir = hum.MoveDirection
        local vel = Vector3.zero

        if moveDir.Magnitude > 0 then
            vel = (cam.CFrame.LookVector * moveDir.Z + cam.CFrame.RightVector * moveDir.X) * FlySpeed
        end

        if FlyUpPressed then vel = vel + Vector3.new(0, FlySpeed, 0) end
        if FlyDownPressed then vel = vel - Vector3.new(0, FlySpeed, 0) end

        flyBV.Velocity = vel
        flyBG.CFrame = cam.CFrame
    else
        if flyBV then flyBV:Destroy() flyBV = nil end
        if flyBG then flyBG:Destroy() flyBG = nil end
    end

    -- АНТИ-ФЛИНГ, АНТИ-АФК, АНТИ-АИМ
    if AntiFlingEnabled and root.AssemblyLinearVelocity.Magnitude > 80 then root.AssemblyLinearVelocity = Vector3.zero end
    if AntiAFKEnabled and tick() - LastAntiAFK > 60 then LastAntiAFK = tick() hum.Jump = true end
    if AntiAimEnabled then root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(math.random(-360, 360)), 0) end
end)

