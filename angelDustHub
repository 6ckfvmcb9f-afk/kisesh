local function SetupCamera()
    if camConn then 
        camConn:Disconnect()
        for i, v in ipairs(Connections) do if v == camConn then table.remove(Connections, i) break end end
    end
    if workspace.CurrentCamera then 
        camConn = workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(UpdateScale) 
        table.insert(Connections, camConn)
    end
    UpdateScale()
end
