-- БЕЗОПАСНЫЕ ФУНКЦИИ
local function SafeConnect(event, func)
    local conn = event:Connect(func)
    table.insert(Connections, conn)
    return conn
end

-- ФИКС 5, 6: Очистка памяти от Tween и проверка IsAlive
local function SafeTween(instance, info, properties)
    if not IsAlive then return nil end
    local tween = TweenService:Create(instance, info, properties)
    table.insert(Tweens, tween)
    tween.Completed:Connect(function()
        for i, v in ipairs(Tweens) do
            if v == tween then table.remove(Tweens, i) break end
        end
    end)
    tween:Play()
    return tween
end

